# =============================================================
# MARIS Environment Configuration
# =============================================================

# Project & Runtime
PROJECT_NAME="MARIS - Maritime AI Intelligence System"
ENVIRONMENT="development"
DEBUG="true"

# Database Configuration (PostGIS / PostgreSQL)
POSTGRES_USER=maris_user
POSTGRES_PASSWORD=maris_secure_password_2026
POSTGRES_DB=maris_db
POSTGRES_PORT=5432
SQLALCHEMY_DATABASE_URI=postgresql://maris_user:maris_secure_password_2026@localhost:5432/maris_db

# Machine Learning & AI
ML_MODEL_MODE=inference
ML_MODEL_PATH=
ML_BACKEND=pytorch

# Frontend API Endpoint
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
