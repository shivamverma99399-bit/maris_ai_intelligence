# MARIS Environment Configuration
PROJECT_NAME="MARIS — Maritime AI Intelligence System"
ENVIRONMENT="development"
DEBUG=true

# API Server
HOST="0.0.0.0"
PORT=8000
API_V1_STR="/api/v1"

# Database (PostgreSQL + PostGIS)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=maris_db

# ML Service Settings
ML_MODE="mock"  # "mock" or "inference"
MODEL_PATH="models/spill_segmentation.onnx"

# OpenDrift & Ocean Data
OCEAN_DATA_PROVIDER="cached"  # "cached", "era5", "copernicus"
OPENDRIFT_NUM_PARTICLES=500
OPENDRIFT_DURATION_HOURS=24
